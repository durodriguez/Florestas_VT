{
  "name": "uvm-arboretum-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive arboretum map for the University of Vermont campus tree collection.",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "labels": "node scripts/make-labels.mjs",
    "dev": "npm run data && vite",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "import": "node scripts/import-survey.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^26.4.0",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
